{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: Compilar hello_world.cpp",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/I", "${fileDirname}\\SDL3\\include",
                "/Fe${fileDirname}\\hello_world.exe",
                "hello_world.cpp",
                "/link",
                "/LIBPATH:${fileDirname}\\SDL3\\lib\\x64",
                "SDL3.lib",
                "Shell32.lib"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Compila el programa hello_world.cpp"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: Compilar template.cpp",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/I", "${fileDirname}\\SDL3\\include",
                "/Fe${fileDirname}\\template.exe",
                "template.cpp",
                "/link",
                "/LIBPATH:${fileDirname}\\SDL3\\lib\\x64",
                "SDL3.lib",
                "Shell32.lib"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Compila el programa template.cpp"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/I", "${fileDirname}\\SDL3\\include",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}",
                "/link",
                "/LIBPATH:${fileDirname}\\SDL3\\lib\\x64",
                "SDL3.lib",
                "Shell32.lib"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compila el archivo activo con SDL3"
        }
    ],
    "version": "2.0.0"
}